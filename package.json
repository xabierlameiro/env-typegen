{
  "name": "env-typegen",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "postinstall": "node scripts/setup-env.mjs",
    "dev": "next dev",
    "dev:local": "portless run next dev",
    "dev:local:https": "portless --https run next dev",
    "build": "next build",
    "generate": "fumadocs-mdx",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next .turbo",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "pnpm test && pnpm test:e2e",
    "analyze": "ANALYZE=true SKIP_ENV_VALIDATION=true next build",
    "knip": "knip",
    "prepare": "husky",
    "changeset": "pnpm --filter @xlameiro/env-typegen changeset",
    "version-packages": "pnpm --filter @xlameiro/env-typegen changeset version",
    "release": "pnpm --filter @xlameiro/env-typegen release",
    "vercel": "npx vercel --prod",
    "vercel:preview": "npx vercel"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{ts,tsx,css,md,json,yaml,yml}": "prettier --write --ignore-unknown"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "husky"
    ],
    "overrides": {
      "flatted": ">=3.4.2",
      "undici": ">=7.28.0 <8.0.0",
      "@babel/core": ">=7.29.6",
      "minimatch@3.1.5>brace-expansion": ">=1.1.18 <2.0.0",
      "minimatch@>=10>brace-expansion": ">=5.0.9",
      "esbuild": ">=0.28.1",
      "fast-uri": ">=3.1.6 <4.0.0",
      "js-yaml@^4.0.0": ">=4.3.2 <5.0.0",
      "path-to-regexp": ">=8.4.0",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.4",
      "smol-toml": ">=1.6.1",
      "ws": ">=7.5.11",
      "yaml": ">=2.8.3"
    },
    "auditConfig": {}
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.13.11",
    "@xlameiro/env-typegen": "^0.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.6.17",
    "fumadocs-mdx": "^14.2.10",
    "fumadocs-ui": "^16.6.17",
    "next": "16.3.6",
    "nuqs": "^2.8.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "temporal-polyfill": "^0.3.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@next/bundle-analyzer": "^16.3.6",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30.0.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-unicorn": "^63.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "knip": "^5.86.0",
    "lint-staged": "^16.4.0",
    "portless": "^0.7.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
